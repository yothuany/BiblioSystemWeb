<% const erros = validationErrors(locals.errors); %>
<% const autor = locals.autor || {} %>

<div class="row page-titles mx-0">

    <div class="col-sm-6 p-md-0">

        <div class="welcome-text">

            <h4>

                <%= locals.titulo %>

            </h4>

            <p class="mb-0">

                &raquo; Adicionar novo autor

            </p>

        </div>

    </div>

    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">

        <ol class="breadcrumb">

            <li class="breadcrumb-item">

                <a href="/">

                    Inicial

                </a>

            </li>

            <li class="breadcrumb-item">

                <a href="/autores">

                    Consulta de Autores

                </a>

            </li>

            <li class="breadcrumb-item active">

                <a href="javascript:void(0)">

                    Novo Autor

                </a>

            </li>

        </ol>

    </div>

</div>

<div class="row">

    <div class="col-lg-12">

        <% if (erros.all.length) { %>

            <div class="alert alert-danger">

                <h5>

                    Não foi possível salvar

                </h5>

                <ul>

                    <% erros.all.forEach(
                        mensagem=>{
                    %>

                        <li>

                            <%= mensagem %>

                        </li>

                    <% }) %>

                </ul>

            </div>

        <% } %>

        <div class="card">

            <div class="card-body">

                <form
                    action="/autores/<%= autor.id ? autor.id + '/editar' : 'criar' %>"
                    method="POST"
                >

                    <div class="form-group mb-3">

                        <label
                            for="nome"
                            class="form-label"
                        >

                            Nome do Autor

                        </label>

                        <input

                            type="text"

                            id="nome"

                            name="nome"

                            class="form-control <%= erros.has('nome') ? 'is-invalid' : '' %>"

                            placeholder="Informe o nome"

                            value="<%= autor.nome || '' %>"

                        >

                        <% if (
                            erros.has(
                                'nome'
                            )
                        ) { %>

                            <div class="invalid-feedback d-block">

                                <ul>

                                    <% erros
                                    .get(
                                        'nome'
                                    )
                                    .forEach(
                                        mensagem=>{
                                    %>

                                    <li>

                                        <%= mensagem %>

                                    </li>

                                    <% }) %>

                                </ul>

                            </div>

                        <% } %>

                    </div>

                    <div class="form-group mb-4">

                        <label
                            for="biografia"
                            class="form-label"
                        >

                            Biografia

                        </label>

                        <textarea

                            id="biografia"

                            name="biografia"

                            rows="6"

                            class="form-control <%= erros.has('biografia') ? 'is-invalid' : '' %>"

                            placeholder="Informe a biografia"

                        ><%= autor.biografia || '' %></textarea>

                        <% if (
                            erros.has(
                                'biografia'
                            )
                        ) { %>

                            <div class="invalid-feedback d-block">

                                <ul>

                                    <% erros
                                    .get(
                                        'biografia'
                                    )
                                    .forEach(
                                        mensagem=>{
                                    %>

                                    <li>

                                        <%= mensagem %>

                                    </li>

                                    <% }) %>

                                </ul>

                            </div>

                        <% } %>

                    </div>

                    <div class="form-group">

                        <button
                            type="submit"
                            class="btn btn-primary mr-2"
                        >

                            Salvar Autor

                        </button>

                        <a
                            href="/autores"
                            class="btn btn-warning"
                        >

                            Cancelar

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>