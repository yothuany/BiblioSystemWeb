<% const erros = validationErrors(locals.errors); %>
<% const membro = locals.membro || {} %>

<div class="row page-titles mx-0">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4>
                <%= locals.titulo %>
            </h4>
            <p class="mb-0">
                &raquo; <%= membro.id ? 'Editar dados do membro' : 'Adicionar novo membro' %>
            </p>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="/">Inicial</a>
            </li>
            <li class="breadcrumb-item">
                <a href="/membros">Consulta de Membros</a>
            </li>
            <li class="breadcrumb-item active">
                <a href="javascript:void(0)">
                    <%= membro.id ? 'Edição' : 'Novo Membro' %>
                </a>
            </li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">

        <% if (erros.all.length) { %>
            <div class="alert alert-danger">
                <h5>Não foi possível salvar</h5>
                <ul>
                    <% erros.all.forEach(mensagem => { %>
                        <li><%= mensagem %></li>
                    <% }) %>
                </ul>
            </div>
        <% } %>

        <div class="card">
            <div class="card-body">
                <form action="<%= membro.id ? '/membros/' + membro.id + '/editar' : '/membros/criar' %>" method="POST">
                    
                    <div class="form-row">
                        <div class="form-group col-md-6 mb-3">
                            <label for="nome" class="form-label">Nome Completo</label>
                            <input type="text" id="nome" name="nome" 
                                   class="form-control <%= erros.has('nome') ? 'is-invalid' : '' %>" 
                                   placeholder="Informe o nome completo" value="<%= membro.nome || '' %>">
                            <% if (erros.has('nome')) { %>
                                <div class="invalid-feedback d-block">
                                    <ul>
                                        <% erros.get('nome').forEach(mensagem => { %>
                                            <li><%= mensagem %></li>
                                        <% }) %>
                                    </ul>
                                </div>
                            <% } %>
                        </div>

                        <div class="form-group col-md-6 mb-3">
                            <label for="cpf" class="form-label">CPF</label>
                            <input type="text" id="cpf" name="cpf" 
                                   class="form-control <%= erros.has('cpf') ? 'is-invalid' : '' %>" 
                                   placeholder="000.000.000-00" value="<%= membro.cpf || '' %>">
                            <% if (erros.has('cpf')) { %>
                                <div class="invalid-feedback d-block">
                                    <ul>
                                        <% erros.get('cpf').forEach(mensagem => { %>
                                            <li><%= mensagem %></li>
                                        <% }) %>
                                    </ul>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6 mb-4">
                            <label for="email" class="form-label">E-mail</label>
                            <input type="email" id="email" name="email" 
                                   class="form-control <%= erros.has('email') ? 'is-invalid' : '' %>" 
                                   placeholder="exemplo@email.com" value="<%= membro.email || '' %>">
                            <% if (erros.has('email')) { %>
                                <div class="invalid-feedback d-block">
                                    <ul>
                                        <% erros.get('email').forEach(mensagem => { %>
                                            <li><%= mensagem %></li>
                                        <% }) %>
                                    </ul>
                                </div>
                            <% } %>
                        </div>

                        <div class="form-group col-md-6 mb-4">
                            <label for="telefone" class="form-label">Telefone / Celular</label>
                            <input type="text" id="telefone" name="telefone" 
                                   class="form-control <%= erros.has('telefone') ? 'is-invalid' : '' %>" 
                                   placeholder="(00) 00000-0000" value="<%= membro.telefone || '' %>">
                            <% if (erros.has('telefone')) { %>
                                <div class="invalid-feedback d-block">
                                    <ul>
                                        <% erros.get('telefone').forEach(mensagem => { %>
                                            <li><%= mensagem %></li>
                                        <% }) %>
                                    </ul>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <div class="form-group mt-2">
                        <button type="submit" class="btn btn-primary mr-2">Salvar Membro</button>
                        <a href="/membros" class="btn btn-warning">Cancelar</a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>