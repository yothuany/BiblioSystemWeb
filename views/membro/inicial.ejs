<div class="row page-titles mx-0">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4>
                <%= titulo %>
            </h4>
            <p class="mb-0">
                &raquo; Consulte todos os membros cadastrados no sistema
            </p>
        </div>
    </div>

    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="/">Inicial</a>
            </li>
            <li class="breadcrumb-item active">
                <a href="javascript:void(0)">Membros</a>
            </li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                
                <div class="basic-form flex-grow-1">
                    <form action="/membros" method="GET">
                        <div class="form-row">
                            <div class="col-lg-10">
                                <input type="text" name="search" class="form-control" 
                                       placeholder="Buscar por nome ou CPF..." value="<%= termoPesquisado %>">
                            </div>
                            <div class="col-lg-2 mt-2 mt-lg-0">
                                <button type="submit" class="btn btn-warning mb-2">
                                    Pesquisar
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <a href="/membros/criar" class="btn btn-primary mb-2 ml-3">
                    Adicionar Novo Membro
                </a>

            </div>

            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-responsive-sm">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Nome</th>
                                <th>CPF</th>
                                <th>E-mail</th>
                                <th>Telefone</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (membros && membros.length > 0) { %>
                                <% for(let index = 0; index < membros.length; index++) { %>
                                    <tr>
                                        <td><%= index + 1 %></td>
                                        <td><strong><%= membros[index].nome %></strong></td>
                                        <td><%= membros[index].cpf %></td>
                                        <td><%= membros[index].email %></td>
                                        <td><%= membros[index].telefone %></td>
                                        <td class="text-nowrap">
                                            <div class="d-flex align-items-center">
                                                <a href="/membros/<%= membros[index].id %>/editar" class="text-warning mr-3">
                                                    <i class="fa fa-pencil fa-lg"></i>
                                                </a>
                                                <a href="/membros/<%= membros[index].id %>/excluir" class="text-danger">
                                                    <i class="fa fa-trash fa-lg"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                <% } %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="text-center">Nenhum membro cadastrado ou encontrado.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>