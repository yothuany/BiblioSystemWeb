<% const erros = validationErrors(locals.errors); %>
<% const categoria = locals.categoria || {} %>

<div class="row page-titles mx-0">

    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4>
                <%= locals.titulo %>
            </h4>
            <p class="mb-0">
                &raquo; Adicionar nova categoria
            </p>
        </div>
    </div>

    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="/">
                    Inicial
                </a>
            </li>
            <li class="breadcrumb-item">
                <a href="/categorias">
                    Consulta de Categorias
                </a>
            </li>
            <li class="breadcrumb-item active">
                <a href="javascript:void(0)">
                    Nova Categoria
                </a>
            </li>
        </ol>
    </div>

</div>

<div class="row">

    <div class="col-lg-12">

        <% if (erros.all.length) { %>
            <div class="alert alert-danger">
                <h5>
                    Não foi possível salvar
                </h5>
                <ul>
                    <% erros.all.forEach(
                        mensagem=>{
                    %>
                        <li>
                            <%= mensagem %>
                        </li>
                    <% }) %>
                </ul>
            </div>
        <% } %>

        <div class="card">

            <div class="card-body">

                <form
                    action="/categorias/<%= categoria.id ? categoria.id + '/editar' : 'criar' %>"
                    method="POST"
                >

                    <div class="form-group mb-3">

                        <label
                            for="nome"
                            class="form-label"
                        >
                            Nome da Categoria
                        </label>

                        <input
                            type="text"
                            id="nome"
                            name="nome"
                            class="form-control <%= erros.has('nome') ? 'is-invalid' : '' %>"
                            placeholder="Informe o nome"
                            value="<%= categoria.nome || '' %>"
                        >

                        <% if (erros.has('nome')) { %>
                            <div class="invalid-feedback d-block">
                                <ul>
                                    <% erros.get('nome').forEach(
                                        mensagem=>{
                                    %>
                                        <li>
                                            <%= mensagem %>
                                        </li>
                                    <% }) %>
                                </ul>
                            </div>
                        <% } %>

                    </div>

                    <div class="form-group mb-4">

                        <label
                            for="descricao"
                            class="form-label"
                        >
                            Descrição
                        </label>

                        <textarea
                            id="descricao"
                            name="descricao"
                            rows="6"
                            class="form-control <%= erros.has('descricao') ? 'is-invalid' : '' %>"
                            placeholder="Informe a descrição"
                        ><%= categoria.descricao || '' %></textarea>

                        <% if (erros.has('descricao')) { %>
                            <div class="invalid-feedback d-block">
                                <ul>
                                    <% erros.get('descricao').forEach(
                                        mensagem=>{
                                    %>
                                        <li>
                                            <%= mensagem %>
                                        </li>
                                    <% }) %>
                                </ul>
                            </div>
                        <% } %>

                    </div>

                    <div class="form-group">

                        <button
                            type="submit"
                            class="btn btn-primary mr-2"
                        >
                            Salvar Categoria
                        </button>

                        <a
                            href="/categorias"
                            class="btn btn-warning"
                        >
                            Cancelar
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>