<% const erros = validationErrors(locals.errors); %>
<% const exemplar = locals.exemplar || {} %>

<div class="row page-titles mx-0">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4>
                <%= locals.titulo %>
            </h4>
            <p class="mb-0">
                &raquo; <%= exemplar.id ? 'Editar exemplar existente' : 'Adicionar novo exemplar' %>
            </p>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="/">
                    Inicial
                </a>
            </li>
            <li class="breadcrumb-item">
                <a href="/exemplares">
                    Consulta de Exemplares
                </a>
            </li>
            <li class="breadcrumb-item active">
                <a href="javascript:void(0)">
                    <%= exemplar.id ? 'Editar Exemplar' : 'Novo Exemplar' %>
                </a>
            </li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        
        <% if (erros.all.length) { %>
            <div class="alert alert-danger">
                <h5>
                    Não foi possível salvar
                </h5>
                <ul>
                    <% erros.all.forEach(mensagem => { %>
                        <li>
                            <%= mensagem %>
                        </li>
                    <% }) %>
                </ul>
            </div>
        <% } %>

        <div class="card">
            <div class="card-body">
                <form
                    action="/exemplares/<%= exemplar.id ? exemplar.id + '/editar' : 'criar' %>"
                    method="POST"
                >

                    <div class="form-group mb-3">
                        <label for="codigo" class="form-label">
                            Código do Exemplar
                        </label>
                        <input 
                            type="text" 
                            id="codigo" 
                            name="codigo" 
                            class="form-control <%= erros.has('codigo') ? 'is-invalid' : '' %>" 
                            placeholder="Ex: EXP1234" 
                            value="<%= exemplar.codigo || '' %>"
                        >
                        <% if (erros.has('codigo')) { %>
                            <div class="invalid-feedback d-block">
                                <ul>
                                    <% erros.get('codigo').forEach(mensagem => { %>
                                        <li><%= mensagem %></li>
                                    <% }) %>
                                </ul>
                            </div>
                        <% } %>
                    </div>

                    <div class="form-group mb-3">
                        <label for="status" class="form-label">
                            Status
                        </label>
                        <select 
                            id="status" 
                            name="status" 
                            class="form-control <%= erros.has('status') ? 'is-invalid' : '' %>"
                        >
                            <option value="Disponível" <%= exemplar.status === 'Disponível' ? 'selected' : '' %>>Disponível</option>
                            <option value="Emprestado" <%= exemplar.status === 'Emprestado' ? 'selected' : '' %>>Emprestado</option>
                            <option value="Reservado" <%= exemplar.status === 'Reservado' ? 'selected' : '' %>>Reservado</option>
                            <option value="Manutenção" <%= exemplar.status === 'Manutenção' ? 'selected' : '' %>>Manutenção</option>
                        </select>
                        <% if (erros.has('status')) { %>
                            <div class="invalid-feedback d-block">
                                <ul>
                                    <% erros.get('status').forEach(mensagem => { %>
                                        <li><%= mensagem %></li>
                                    <% }) %>
                                </ul>
                            </div>
                        <% } %>
                    </div>

                    <div class="form-group mb-4">
                        <label for="livroId" class="form-label">
                            Livro Vinculado
                        </label>
                        <select 
                            id="livroId" 
                            name="livroId" 
                            class="form-control <%= erros.has('livroId') ? 'is-invalid' : '' %>"
                        >
                            <option value="" disabled <%= !exemplar.livroId ? 'selected' : '' %>>-- Selecione um Livro --</option>
                            <% if (locals.livros && livros.length > 0) { %>
                                <% livros.forEach(livro => { %>
                                    <option value="<%= livro.id %>" <%= String(exemplar.livroId) === String(livro.id) ? 'selected' : '' %>>
                                        <%= livro.titulo %>
                                    </option>
                                <% }) %>
                            <% } %>
                        </select>
                        <% if (erros.has('livroId')) { %>
                            <div class="invalid-feedback d-block">
                                <ul>
                                    <% erros.get('livroId').forEach(mensagem => { %>
                                        <li><%= mensagem %></li>
                                    <% }) %>
                                </ul>
                            </div>
                        <% } %>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-primary mr-2">
                            Salvar Exemplar
                        </button>
                        <a href="/exemplares" class="btn btn-warning">
                            Cancelar
                        </a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>